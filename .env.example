NODE_ENV=development
PORT=3000

# MongoDB replica set (user registration uses a transaction)
DB_URI=mongodb://127.0.0.1:27017/subdub?replicaSet=rs0

# Replace placeholders locally; never commit real credentials.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES=7d

ARCJET_KEY=replace-with-your-arcjet-key
ARCJET_ENV=development

# Use the endpoint and token configured for your QStash account.
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=replace-with-your-qstash-token
QSTASH_CURRENT_SIGNING_KEY=replace-with-current-signing-key
QSTASH_NEXT_SIGNING_KEY=replace-with-next-signing-key

# Public API origin used as the QStash workflow callback base URL.
SERVER_URL=https://your-public-api.example.com

# Gmail app password or other configured Gmail SMTP credential.
EMAIL_PASSWORD=replace-with-your-email-credential
